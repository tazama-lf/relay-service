# Nats - Consumer
STARTUP_TYPE=nats
NODE_ENV=dev
MAX_CPU=4
SERVER_URL=nats:4222
FUNCTION_NAME=messageRelayService
CONSUMER_STREAM=interdiction-service
PRODUCER_STREAM=destination.subject
OUTPUT_TO_JSON=true

# Producer config below
DESTINATION_TRANSPORT_TYPE=@tazama-lf/nats-relay-plugin
DESTINATION_TRANSPORT_URL=nats://localhost:4222
NATS_AUTHENTICATED=false
NATS_CERTIFICATE_AUTHORITY_PATH=
NATS_CLIENT_CERT_PATH=
NATS_CLIENT_KEY_PATH=

DESTINATION_NATS_AUTHENTICATED=true
DESTINATION_NATS_CERTIFICATE_AUTHORITY_PATH=
DESTINATION_NATS_CLIENT_CERT_PATH=
DESTINATION_NATS_CLIENT_KEY_PATH=

APM_ACTIVE=false
APM_SERVICE_NAME=relay-service
APM_URL=http://localhost:8200/
APM_SECRET_TOKEN=

LOGSTASH_LEVEL='info'
SIDECAR_HOST=0.0.0.0:5000